{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".oxlintrc.json", "tools/oxlint/**"],
  "tasks": {
    // Internal packages are just-in-time (`exports` point at source), so a package's
    // typecheck, lint, and test results depend on its dependencies' source. The
    // `transit` node carries their hashes forward without making dependents wait
    // for dependency tasks to finish.
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    // Tests of the Container's scripts skip on a host without its Linux tools, but
    // never under `CI`, so a run with it hashes apart from one without.
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "env": ["CI"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["dist/**"]
    }
  }
}
