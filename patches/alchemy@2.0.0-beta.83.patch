+/**
+ * Whether the containers API rejected the application because its namespace is
+ * not Container-enabled yet. Cloudflare reports it either with the documented
+ * code (`DurableObjectNotContainerEnabled`) or as a plain 400
+ * `{"error":"VALIDATE_INPUT","details":{"durable_objects":"Durable Object namespace is not Container-enabled"}}`.
+ */
+const isNamespaceNotContainerEnabled = (error) => error._tag === "DurableObjectNotContainerEnabled" ||
+    (error._tag === "BadRequest" &&
+        typeof error.message === "string" &&
+        error.message.includes("not Container-enabled"));
+/**
+ * A namespace becomes Container-enabled when its Worker uploads a version
+ * whose `containers` metadata names the class. A new Worker does that in its
+ * precreate placeholder, before the application is created. An EXISTING
+ * Worker that gains a Container is a cycle peer being updated: it publishes
+ * its previous attributes (with the namespace id) before its upload, which
+ * waits for the image build, so the application's create runs first and is
+ * rejected. Wait for that upload instead of failing the deploy, bounded at
+ * ~15 minutes to cover a cold image build and push.
+ */
+export const retryContainerEnablement = (effect, onWait) => effect.pipe(Effect.tapError((error) => (isNamespaceNotContainerEnabled(error) ? onWait : Effect.void)), Effect.retry({
+    while: isNamespaceNotContainerEnabled,
+    schedule: Schedule.spaced("5 seconds"),
+    times: 180,
+}));
