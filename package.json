{
  "name": "cloudpid",
  "version": "0.0.0",
  "private": true,
  "description": "A personal, always-on pi coding agent on Cloudflare",
  "workspaces": [
    "apps/*",
    "infra",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run typecheck lint test && bun run format:check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "prepare": "husky && effect-tsgo patch --typescript --oxlint && ./scripts/sync-reference-repos.sh",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@effect/tsgo": "0.59.0",
    "@oxlint/plugins": "1.89.0",
    "husky": "^9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "skills": "^1.7.4",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.6"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "oxlint --fix --no-error-on-unmatched-pattern",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "@cloudflare/computer@0.8.0": "patches/@cloudflare__computer@0.8.0.patch",
    "@cloudflare/vitest-plugin@1.4.8": "patches/@cloudflare__vitest-plugin@1.4.8.patch",
    "@alchemy.run/cloudflare@2.0.0-beta.84": "patches/@alchemy.run__cloudflare@2.0.0-beta.84.patch",
    "@earendil-works/pi-durable@1.4.0": "patches/@earendil-works__pi-durable@1.4.0.patch"
  },
  "trustedDependencies": [
    "@google/genai",
    "@mongodb-js/zstd",
    "core-js-pure",
    "esbuild",
    "node-liblzma",
    "oxlint",
    "oxlint-tsgolint",
    "protobufjs",
    "typescript",
    "workerd"
  ]
}
