{
  "name": "cloudpid",
  "version": "0.0.0",
  "private": true,
  "description": "Pi on Cloudflare",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run typecheck lint test && pnpm run format:check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "prepare": "husky && effect-tsgo patch --typescript --oxlint && ./scripts/sync-reference-repos.sh",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@effect/tsgo": "0.56.0",
    "@oxlint/plugins": "1.89.0",
    "husky": "^9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "skills": "^1.7.4",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "oxlint --fix --no-error-on-unmatched-pattern",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0"
}
