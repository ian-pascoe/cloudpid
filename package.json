{
  "name": "cloudpid",
  "version": "0.0.0",
  "private": true,
  "description": "A personal, always-on pi coding agent on Cloudflare",
  "workspaces": [
    "apps/*",
    "infra",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "check": "vp check && vp run -r typecheck && vp run -r test",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "prepare": "./scripts/prepare.sh",
    "test": "vp run -r test",
    "typecheck": "vp run -r typecheck"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@effect/tsgo": "0.64.1",
    "skills": "^1.7.6",
    "typescript": "^7.0.2",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "pnpm@12.18.0",
  "pi": {
    "extensions": [
      "./packages/pi-cloudpid/src/index.ts"
    ]
  }
}
