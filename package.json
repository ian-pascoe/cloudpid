{
  "name": "cloudpid",
  "version": "0.0.0",
  "description": "Pi on Cloudflare",
  "type": "module",
  "scripts": {
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky && effect-tsgo patch --typescript --oxlint && ./scripts/sync-reference-repos.sh",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@cloudflare/computer": "^0.5.1",
    "@earendil-works/chord": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-durable": "^1.3.0",
    "alchemy": "2.0.0-beta.83",
    "effect": "^4.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@effect/tsgo": "0.53.4",
    "@oxlint/plugins": "1.88.0",
    "husky": "^9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "skills": "^1.7.2",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "oxlint --fix --no-error-on-unmatched-pattern",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0"
}
