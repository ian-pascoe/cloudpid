{
  "name": "@cloudpid/pi-cloudpid",
  "version": "0.0.0",
  "private": true,
  "description": "pi extension: /cloudpid imports the active pi Session into cloudpid",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node build.ts",
    "typecheck": "effect-tsgo tsrs",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@ian-pascoe/pi-utils": "^0.13.0",
    "@modelcontextprotocol/client": "2.4.0",
    "effect": "^4.1.2"
  },
  "devDependencies": {
    "@cloudpid/config": "workspace:*",
    "@cloudpid/mcp": "workspace:*",
    "@cloudpid/protocol": "workspace:*",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^26.6.6",
    "typebox": "1.4.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
