#!/bin/bash
# The Container's entrypoint (docs/spec.md → Container and Toolchains → Exit reports). It runs computerd, passing its
# output through to the Container's own log as before, and keeps the last lines of it. When computerd exits without
# having been asked to (no SIGTERM or SIGINT reached this script), its status, how long it ran and those lines are
# posted to the Workspace DO's report host, which writes them to the Workers logs: the platform keeps a Container's
# output where no API reads it, and computer records only that the Container exited. The lines are kept in memory (a
# tmpfs where there is one), never on the Container's disk, which a snapshot captures. A report that cannot be sent is
# dropped; the exit status is computerd's either way.
#
# computerd's log lines can carry file contents as `data:<mime>;base64,<payload>` runs, hundreds of KB each, which would
# fill the report and push out the lines that matter (a crash and its stack). The kept copy, not the passthrough, has
# each payload of at least `base64_min` characters replaced by a marker before the last lines are chosen, by a
# line-buffered sed that reads a line of any length as it comes (a payload cut off by the end of its line collapses too).
#
# The host, the path and the number of lines are those of `@cloudpid/sandbox-image/supervisor`; CLOUDPID_COMPUTERD and
# CLOUDPID_REPORT_* exist for its tests, and the image sets none of them.
set -u

computerd=${CLOUDPID_COMPUTERD:-/usr/local/bin/computerd}
report_host=${CLOUDPID_REPORT_HOST:-cloudpid.internal}
report_port=${CLOUDPID_REPORT_PORT:-80}
report_path=/container-exit
keep_lines=200
# The most of the kept lines sent, in bytes: the end of them when they are longer.
keep_bytes=32768
# A base64 payload of a data URL this long (or longer) is replaced by a marker in the kept lines.
base64_min=64
base64_marker='[base64 dropped]'
collapse_base64="s#(data:[-A-Za-z0-9.+/;=_]*;base64,)[-A-Za-z0-9+/=_]{${base64_min},}#\\1${base64_marker}#g"

scratch=$(mktemp -d /dev/shm/cloudpid-supervise.XXXXXX 2>/dev/null || mktemp -d)
mkfifo "$scratch/out" "$scratch/keep"

# tee passes computerd's output on and copies it to sed, which collapses the data URLs' payloads, and tail, which holds
# the last lines until the output ends.
sed -u -E "$collapse_base64" <"$scratch/keep" | tail -n "$keep_lines" >"$scratch/tail" &
tail_pid=$!
tee "$scratch/keep" <"$scratch/out" &
tee_pid=$!

# A Container started from its Environment's Build (CLOUDPID_RESET_STORE=1 in the launch's environment) has the Build's
# computerd store on its disk, with the sync positions of the Build's own Durable Object: computerd starts with an
# empty one instead, so this Workspace's Durable Object pushes it every file (docs/spec.md → Builds).
if [ "${CLOUDPID_RESET_STORE:-}" = 1 ] && [ -n "${COMPUTERD_DB:-}" ]; then
  rm -f -- "$COMPUTERD_DB" "$COMPUTERD_DB-wal" "$COMPUTERD_DB-shm"
fi

started=$SECONDS
"$computerd" "$@" >"$scratch/out" 2>&1 &
computerd_pid=$!

asked=0
trap 'asked=1; kill -TERM "$computerd_pid" 2>/dev/null' TERM INT

# A trapped signal ends `wait` early, with computerd still running: wait again until it is gone.
while :; do
  wait "$computerd_pid"
  status=$?
  kill -0 "$computerd_pid" 2>/dev/null || break
done

# The output ends when computerd's last writer closes it. A process it left behind could hold it open: give tee two
# seconds, then stop it, which ends tail's input too.
(sleep 2 && kill "$tee_pid" 2>/dev/null) &
watchdog=$!
wait "$tee_pid" 2>/dev/null
kill "$watchdog" 2>/dev/null
wait "$tail_pid" 2>/dev/null

if [ "$asked" = 0 ]; then
  {
    printf 'status=%s\nuptime=%s\n\n' "$status" "$((SECONDS - started))"
    tail -c "$keep_bytes" "$scratch/tail"
  } >"$scratch/report"

  # bash's /dev/tcp, so the image needs no HTTP client. Five seconds at most: the Container is on its way down.
  timeout 5 bash -c '
    exec 3<>"/dev/tcp/$1/$2" || exit 1
    printf "POST %s HTTP/1.1\r\nHost: %s\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: %s\r\nConnection: close\r\n\r\n" \
      "$3" "$1" "$(wc -c <"$4")" >&3
    cat "$4" >&3
    head -c 64 <&3 >/dev/null
  ' _ "$report_host" "$report_port" "$report_path" "$scratch/report" 2>/dev/null || true
fi

rm -rf "$scratch"
exit "$status"
