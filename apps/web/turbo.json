{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // Tests (and the typecheck and lint that follow their imports) of the App View code read a few files of other packages by
    // relative path, which turbo does not see as inputs of this one: the server's sandbox constants (`frame-url.test.ts`, the
    // drift guard) and the sandbox's proxy script (`example-view.test.ts`, which runs the real one). A package dependency
    // would hash the whole server for every web change, so the files are named here.
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/apps/server/src/view-host.ts",
        "$TURBO_ROOT$/apps/server/src/deployment.ts",
        "$TURBO_ROOT$/apps/app-sandbox/src/proxy.ts"
      ]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/apps/server/src/view-host.ts",
        "$TURBO_ROOT$/apps/server/src/deployment.ts",
        "$TURBO_ROOT$/apps/app-sandbox/src/proxy.ts"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/apps/server/src/view-host.ts",
        "$TURBO_ROOT$/apps/server/src/deployment.ts",
        "$TURBO_ROOT$/apps/app-sandbox/src/proxy.ts"
      ]
    }
  }
}
